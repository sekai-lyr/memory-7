<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.picture.mapper.SekaiPictureCategoryMapper">
    <resultMap id="BaseResultMap" type="com.sekai.picture.dataobject.SekaiPictureCategoryDO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <sql id="Base_Column_List">id, user_id, name, description, cover_url, create_time, update_time</sql>
    <insert id="insert" parameterType="com.sekai.picture.dataobject.SekaiPictureCategoryDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_picture_category (user_id, name, description, cover_url)
        VALUES (#{userId}, #{name}, #{description}, #{coverUrl})
    </insert>
    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM sekai_picture_category WHERE id = #{id}
    </select>
    <select id="listByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sekai_picture_category
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>
    <select id="countByUserId" resultType="int">
        SELECT COUNT(1) FROM sekai_picture_category WHERE user_id = #{userId}
    </select>
</mapper>

